{
  "description": "Explain the vc.Agentic purpose and point agents to the entry point.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/tools/agent_entry.py\"",
            "statusMessage": "Loading vc.Agentic entry point"
          }
        ]
      }
    ]
  }
}
